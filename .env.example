# ==========================================
# Database (PostgreSQL) — docker-compose service `db`
# ==========================================
POSTGRES_USER=admin
POSTGRES_PASSWORD=secretpassword
POSTGRES_DB=app_database

# ==========================================
# AI / Trích xuất (extract_module)
# ==========================================
GEMINI_API_KEY=
QWEN_API_KEY=
MAX_RETRIES=4
DEFAULT_EXTRACT_PAGES=1
USE_OCR=false
PADDLE_MODEL_SIZE=tiny

# ==========================================
# Ánh xạ MARC / RAG (mapping_module) — tùy chọn
# Mặc định suy ra từ vị trí source; chỉ set khi chạy trong Docker.
# ==========================================
# LCC_PDF_FOLDER=/app/mapping_module/file_tailieu
# SUBJECT_650_PDF_FOLDER=/app/mapping_module/file_subject_650
